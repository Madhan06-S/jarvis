<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S. COMPANION"
        android:textColor="#00BFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android Call Automation &amp; Sync Core"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/etServerIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Desktop IP (e.g. 192.168.1.100)"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:inputType="textUri"
        app:layout_constraintTop_toBottomOf="@id/tvSub"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESTABLISH SECURE LINK"
        android:backgroundTint="#00BFFF"
        android:textColor="#121212"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etServerIp"
        android:layout_marginTop="16dp" />

    <!-- Services settings toggles -->
    <TextView
        android:id="@+id/tvSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AUTOMATION ACCESSORIES"
        android:textColor="#00BFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnConnect"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnPermissionNotify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Notification Sync Access"
        android:backgroundTint="#222222"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvSettings"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnPermissionAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant UI Accessibility Access"
        android:backgroundTint="#222222"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnPermissionNotify"
        android:layout_marginTop="8dp" />

    <!-- Status Log output -->
    <TextView
        android:id="@+id/tvStatusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REALTIME CONSOLE LOGS"
        android:textColor="#00ff88"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnPermissionAccess"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="32dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#050505"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[COMPANION] Console online. Waiting for connection parameters..."
            android:textColor="#00ff88"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
